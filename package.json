{
  "name": "minetrack",
  "version": "5.6.1",
  "description": "A Minecraft server tracker that lets you focus on the basics.",
  "private": true,
  "dependencies": {
    "finalhandler": "^2.1.1",
    "mcpe-ping-fixed": "0.0.3",
    "mcping-js": "^1.5.0",
    "serve-static": "^2.2.1",
    "sqlite3": "^6.0.1",
    "uplot": "1.6.32",
    "winston": "^2.4.7",
    "ws": "^8.21.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cryptkeeper/Minetrack.git"
  },
  "keywords": [
    "minetrack"
  ],
  "author": "Nick Krecklow <hello@npm.nklow.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Cryptkeeper/Minetrack/issues"
  },
  "homepage": "https://github.com/Cryptkeeper/Minetrack#README",
  "engines": {
    "node": ">=22.13.0"
  },
  "targets": {
    "main": {
      "engines": {
        "browsers": "defaults"
      },
      "includeNodeModules": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "parcel": "^2.16.4"
  },
  "scripts": {
    "build": "npm run lint && parcel build assets/html/index.html --dist-dir dist",
    "dev": "parcel build assets/html/index.html --no-optimize --dist-dir dist",
    "lint": "eslint",
    "start": "node main.js"
  }
}
